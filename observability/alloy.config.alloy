// eTribunal — Alloy: logs de los contenedores -> Loki
// Escaneo de contenedores Docker y envío a Loki (:3100), preservando el label
// container_name para poder filtrar por servicio (ej: etribunal-gateway).
// Patrón documentado de Grafana: discovery.relabel define las rules, el
// loki.source.docker las aplica sobre los meta-labels del target.
discovery.docker "docker_scrape" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.docker_scrape.targets
  labels        = { job = "etribunal" }
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}